<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <!-- SDK-style SQL Database Project: every .sql file under this folder is part of the model,
       except what is removed below. Build: dotnet build  ->  bin/Debug/TrailheadOps.dacpac -->
  <PropertyGroup>
    <Name>TrailheadOps</Name>
    <!-- Target platform. Azure SQL Database here; Sql170DatabaseSchemaProvider = SQL Server 2025,
         SqlDbFabricDatabaseSchemaProvider = SQL database in Fabric. Build validates syntax for it. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TreatTSqlWarningsAsErrors>false</TreatTSqlWarningsAsErrors>
    <RunSqlCodeAnalysis>true</RunSqlCodeAnalysis>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
    <!-- Static code analysis on build (e.g. SR0001 SELECT *, SR0007 nullable columns in predicates).
         Promote a rule to an error with: <SqlCodeAnalysisRules>+!Microsoft.Rules.Data.SR0001</SqlCodeAnalysisRules> -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Tests and deployment scripts are not schema objects -->
    <Build Remove="tests/**" />
    <Build Remove="Scripts/**" />
    <PostDeploy Include="Scripts/Script.PostDeployment.sql" />
    <None Include="Scripts/**" />
    <None Include="tests/**" />
  </ItemGroup>
</Project>